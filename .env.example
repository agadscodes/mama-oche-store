# ==============================================================
# Mama Oche E-Commerce Platform — Environment Configuration Template
# ==============================================================
# Copy this file to .env.local and populate with your own project credentials.
# Note: Do NOT commit .env.local to GitHub.

# Supabase Project Configuration
# Found at: https://supabase.com/dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Store Details & Abuja Contact Configuration
NEXT_PUBLIC_STORE_PHONE=09034006248
NEXT_PUBLIC_STORE_WHATSAPP=2349034006248
NEXT_PUBLIC_STORE_EMAIL=orders@mamaoche.ng
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Email / Notification Service (Mailgun)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
